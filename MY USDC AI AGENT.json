        "jsCode": "const crypto = require('crypto');\n\n// Get the public key from the previous node\nconst publicKey = $input.first().json.data.publicKey;\n\n// Your entity secret (we'll improve how this is stored in a moment)\nconst entitySecret = \"YOUR ENTITY SECRET \";\n\n// Convert entity secret from hex text into raw bytes\nconst entitySecretBuffer = Buffer.from(entitySecret, 'hex');\n\n// Seal it using Circle's public key\nconst encryptedData = crypto.publicEncrypt(\n  {\n    key: publicKey,\n    padding: crypto.constants.RSA_PKCS1_OAEP_PADDING,\n    oaepHash: 'sha256',\n  },\n  entitySecretBuffer\n);\n\nconst entitySecretCiphertext = encryptedData.toString('base64');\nconst idempotencyKey = crypto.randomUUID();\n\nreturn [{ json: { entitySecretCiphertext, idempotencyKey } }];"
      },
